# Server runtime: development, test, or production.
NODE_ENV=development
# Render supplies PORT. Local server defaults to 3000 when omitted.
PORT=3000
# Local tests replace this with an ephemeral MongoDB replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/apartcheck?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-characters
# Canonical browser origin used for CORS and QR links.
APP_BASE_URL=http://localhost:5173
# Number of trusted reverse-proxy hops. Render uses one.
TRUST_PROXY_HOPS=0
# Cloudinary authenticated image storage credentials. Leave blank locally to use
# bounded in-memory image storage; required in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Hex-encoded Cloudinary authenticated-delivery token key.
CLOUDINARY_AUTH_TOKEN_KEY=
